{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Interactive Collapsible Org Chart Visual with Total Descendants Count for Power BI using Deneb & Vega",
  "padding": 15,
  "autosize": "none",
  "signals": [
    {
      "name": "cardWidth",
      "value": 145,
      "description": "Width of each employee card in pixels"
    },
    {
      "name": "cardHeight",
      "value": 54,
      "description": "Height of each employee card in pixels"
    },
    {
      "name": "nodeSpacingX",
      "value": 175,
      "description": "Horizontal distance between sibling node centers (must be > cardWidth)"
    },
    {
      "name": "nodeSpacingY",
      "value": 95,
      "description": "Vertical distance between hierarchy level centers (must be > cardHeight)"
    },
    {
      "name": "topMargin",
      "value": 30,
      "description": "Top margin offset from visual boundary"
    },
    {
      "name": "collapsedIds",
      "value": ",",
      "description": "Delimited string of node IDs whose subtrees are currently collapsed",
      "on": [
        {
          "events": "@toggleBtn:click, @toggleText:click",
          "update": "indexof(collapsedIds, ',' + datum.id + ',') >= 0 ? replace(collapsedIds, datum.id + ',', '') : collapsedIds + datum.id + ','"
        },
        {
          "events": "@expandAllBtn:click, @expandAllText:click",
          "update": "','"
        }
      ]
    },
    {
      "name": "hoveredId",
      "value": null,
      "on": [
        {
          "events": "@cardBody:mouseover",
          "update": "datum.id"
        },
        {
          "events": "@cardBody:mouseout",
          "update": "null"
        }
      ]
    }
  ],
  "data": [
    {
      "name": "dataset",
      "values": [
        {
          "ID": "1",
          "ParentID": null,
          "Name": "Sarah Jenkins",
          "Title": "Chief Executive Officer"
        },
        {
          "ID": "2",
          "ParentID": "1",
          "Name": "David Chen",
          "Title": "VP of Engineering"
        },
        {
          "ID": "3",
          "ParentID": "1",
          "Name": "Elena Rostova",
          "Title": "VP of Product"
        },
        {
          "ID": "4",
          "ParentID": "1",
          "Name": "Marcus Vance",
          "Title": "VP of Sales & Marketing"
        },
        {
          "ID": "5",
          "ParentID": "2",
          "Name": "Alex Rivera",
          "Title": "Director of Platform"
        },
        {
          "ID": "6",
          "ParentID": "2",
          "Name": "Priya Sharma",
          "Title": "Director of QA & Infra"
        },
        {
          "ID": "7",
          "ParentID": "3",
          "Name": "Liam O'Connor",
          "Title": "Principal UX Lead"
        },
        {
          "ID": "8",
          "ParentID": "3",
          "Name": "Sophia Martinez",
          "Title": "Lead Product Manager"
        },
        {
          "ID": "9",
          "ParentID": "4",
          "Name": "Chloe Bennett",
          "Title": "Regional Sales Director"
        },
        {
          "ID": "10",
          "ParentID": "4",
          "Name": "Tariq Al-Mansoor",
          "Title": "Head of Growth"
        },
        {
          "ID": "11",
          "ParentID": "5",
          "Name": "James Wilson",
          "Title": "Staff Cloud Architect"
        },
        {
          "ID": "12",
          "ParentID": "5",
          "Name": "Emma Watson",
          "Title": "Senior DevOps Lead"
        }
      ]
    },
    {
      "name": "clean_data",
      "source": "dataset",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum['ID']) && datum['ID'] !== '' && datum['ID'] !== null"
        },
        {
          "type": "formula",
          "expr": "toString(datum['ID'])",
          "as": "id"
        },
        {
          "type": "formula",
          "expr": "isValid(datum['ParentID']) && datum['ParentID'] !== '' && datum['ParentID'] !== null && datum['ParentID'] !== '0' && datum['ParentID'] !== 0 && datum['ParentID'] != datum['ID'] ? toString(datum['ParentID']) : null",
          "as": "parentId"
        },
        {
          "type": "formula",
          "expr": "isValid(datum['Name']) && datum['Name'] !== '' ? toString(datum['Name']) : 'Unknown'",
          "as": "Name_clean"
        },
        {
          "type": "formula",
          "expr": "isValid(datum['Title']) && datum['Title'] !== '' ? toString(datum['Title']) : 'Team Member'",
          "as": "Title_clean"
        }
      ]
    },
    {
      "name": "report_counts",
      "source": "clean_data",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.parentId)"
        },
        {
          "type": "aggregate",
          "groupby": [
            "parentId"
          ],
          "ops": [
            "count"
          ],
          "as": [
            "reportCount"
          ]
        }
      ]
    },
    {
      "name": "lineage_base",
      "source": "clean_data",
      "transform": [
        {
          "type": "lookup",
          "from": "clean_data",
          "key": "id",
          "fields": [
            "parentId"
          ],
          "values": [
            "parentId"
          ],
          "as": [
            "anc1"
          ]
        },
        {
          "type": "lookup",
          "from": "clean_data",
          "key": "id",
          "fields": [
            "anc1"
          ],
          "values": [
            "parentId"
          ],
          "as": [
            "anc2"
          ]
        },
        {
          "type": "lookup",
          "from": "clean_data",
          "key": "id",
          "fields": [
            "anc2"
          ],
          "values": [
            "parentId"
          ],
          "as": [
            "anc3"
          ]
        },
        {
          "type": "lookup",
          "from": "clean_data",
          "key": "id",
          "fields": [
            "anc3"
          ],
          "values": [
            "parentId"
          ],
          "as": [
            "anc4"
          ]
        }
      ]
    },
    {
      "name": "descendant_counts",
      "source": "lineage_base",
      "transform": [
        {
          "type": "fold",
          "fields": [
            "parentId",
            "anc1",
            "anc2",
            "anc3",
            "anc4"
          ],
          "as": [
            "ancLevel",
            "ancestorId"
          ]
        },
        {
          "type": "filter",
          "expr": "isValid(datum.ancestorId) && datum.ancestorId !== '' && datum.ancestorId !== null"
        },
        {
          "type": "aggregate",
          "groupby": [
            "ancestorId"
          ],
          "ops": [
            "count"
          ],
          "as": [
            "totalDescendants"
          ]
        }
      ]
    },
    {
      "name": "data_with_lineage",
      "source": "lineage_base",
      "transform": [
        {
          "type": "lookup",
          "from": "report_counts",
          "key": "parentId",
          "fields": [
            "id"
          ],
          "values": [
            "reportCount"
          ],
          "as": [
            "reportCount"
          ],
          "default": 0
        },
        {
          "type": "lookup",
          "from": "descendant_counts",
          "key": "ancestorId",
          "fields": [
            "id"
          ],
          "values": [
            "totalDescendants"
          ],
          "as": [
            "totalDescendants"
          ],
          "default": 0
        },
        {
          "type": "formula",
          "expr": "(isValid(datum.parentId) && indexof(collapsedIds, ',' + datum.parentId + ',') >= 0) || (isValid(datum.anc1) && indexof(collapsedIds, ',' + datum.anc1 + ',') >= 0) || (isValid(datum.anc2) && indexof(collapsedIds, ',' + datum.anc2 + ',') >= 0) || (isValid(datum.anc3) && indexof(collapsedIds, ',' + datum.anc3 + ',') >= 0) || (isValid(datum.anc4) && indexof(collapsedIds, ',' + datum.anc4 + ',') >= 0)",
          "as": "isCollapsedDescendant"
        }
      ]
    },
    {
      "name": "tree_nodes",
      "source": "data_with_lineage",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.isCollapsedDescendant"
        },
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parentId"
        },
        {
          "type": "tree",
          "method": "tidy",
          "nodeSize": [
            {
              "signal": "nodeSpacingX"
            },
            {
              "signal": "nodeSpacingY"
            }
          ],
          "separation": false,
          "as": [
            "rawX",
            "rawY",
            "depth",
            "children"
          ]
        },
        {
          "type": "joinaggregate",
          "fields": [
            "rawX",
            "rawX"
          ],
          "ops": [
            "min",
            "max"
          ],
          "as": [
            "minX",
            "maxX"
          ]
        },
        {
          "type": "formula",
          "expr": "max(30, (width - (datum.maxX - datum.minX + cardWidth)) / 2) - datum.minX",
          "as": "originX"
        },
        {
          "type": "formula",
          "expr": "datum.rawX + datum.originX",
          "as": "cardX"
        },
        {
          "type": "formula",
          "expr": "datum.rawY + topMargin",
          "as": "cardY"
        },
        {
          "type": "formula",
          "expr": "datum.cardX + (cardWidth / 2)",
          "as": "centerX"
        },
        {
          "type": "formula",
          "expr": "datum.cardY",
          "as": "cardTop"
        },
        {
          "type": "formula",
          "expr": "datum.cardY + cardHeight",
          "as": "cardBottom"
        },
        {
          "type": "formula",
          "expr": "datum.cardY + 2",
          "as": "shadowY"
        },
        {
          "type": "formula",
          "expr": "datum.cardX + 3",
          "as": "accentX"
        },
        {
          "type": "formula",
          "expr": "datum.cardY + 7",
          "as": "accentY"
        },
        {
          "type": "formula",
          "expr": "datum.cardX + 14",
          "as": "textX"
        },
        {
          "type": "formula",
          "expr": "datum.cardY + 20",
          "as": "nameY"
        },
        {
          "type": "formula",
          "expr": "datum.cardY + 36",
          "as": "titleY"
        },
        {
          "type": "formula",
          "expr": "datum.cardX + cardWidth - 26",
          "as": "badgeX"
        },
        {
          "type": "formula",
          "expr": "datum.cardY + 5",
          "as": "badgeY"
        },
        {
          "type": "formula",
          "expr": "datum.cardX + cardWidth - 17",
          "as": "badgeTextX"
        },
        {
          "type": "formula",
          "expr": "datum.cardY + 11",
          "as": "badgeTextY"
        },
        {
          "type": "formula",
          "expr": "datum.cardX + cardWidth - 44",
          "as": "descendantBadgeX"
        },
        {
          "type": "formula",
          "expr": "datum.cardX + cardWidth - 30",
          "as": "descendantTextX"
        },
        {
          "type": "formula",
          "expr": "datum.cardY + cardHeight - 16",
          "as": "descendantBadgeY"
        },
        {
          "type": "formula",
          "expr": "datum.cardY + cardHeight - 10.5",
          "as": "descendantTextY"
        },
        {
          "type": "formula",
          "expr": "datum.centerX - 14",
          "as": "toggleBtnX"
        },
        {
          "type": "formula",
          "expr": "datum.cardBottom - 7",
          "as": "toggleBtnY"
        },
        {
          "type": "formula",
          "expr": "datum.toggleBtnY + 7",
          "as": "toggleTextY"
        },
        {
          "type": "formula",
          "expr": "indexof(collapsedIds, ',' + datum.id + ',') >= 0",
          "as": "isCollapsed"
        },
        {
          "type": "formula",
          "expr": "datum.isCollapsed ? ('+' + datum.totalDescendants) : '-'",
          "as": "toggleLabel"
        }
      ]
    },
    {
      "name": "tree_links",
      "source": "tree_nodes",
      "transform": [
        {
          "type": "treelinks"
        },
        {
          "type": "linkpath",
          "orient": "vertical",
          "shape": "orthogonal",
          "sourceX": "source.centerX",
          "sourceY": "source.cardBottom",
          "targetX": "target.centerX",
          "targetY": "target.cardTop"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "levelColor",
      "type": "ordinal",
      "domain": [
        0,
        1,
        2,
        3,
        4
      ],
      "range": [
        "#1D4ED8",
        "#0284C7",
        "#0F766E",
        "#7C3AED",
        "#64748B"
      ]
    },
    {
      "name": "levelBg",
      "type": "ordinal",
      "domain": [
        0,
        1,
        2,
        3,
        4
      ],
      "range": [
        "#EFF6FF",
        "#F0F9FF",
        "#F0FDFA",
        "#F5F3FF",
        "#F8FAFC"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "name": "expandAllBtn",
      "encode": {
        "update": {
          "x": {
            "value": 15
          },
          "y": {
            "value": 10
          },
          "width": {
            "value": 78
          },
          "height": {
            "value": 22
          },
          "cornerRadius": {
            "value": 4
          },
          "fill": {
            "value": "#F1F5F9"
          },
          "stroke": {
            "value": "#CBD5E1"
          },
          "strokeWidth": {
            "value": 1
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "expandAllText",
      "encode": {
        "update": {
          "x": {
            "value": 54
          },
          "y": {
            "value": 22
          },
          "text": {
            "value": "Expand All"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 9.5
          },
          "fontWeight": {
            "value": "600"
          },
          "fill": {
            "value": "#475569"
          },
          "cursor": {
            "value": "pointer"
          },
          "font": {
            "value": "Segoe UI, -apple-system, sans-serif"
          }
        }
      }
    },
    {
      "type": "path",
      "name": "treeLinkPath",
      "from": {
        "data": "tree_links"
      },
      "encode": {
        "update": {
          "path": {
            "field": "path"
          },
          "stroke": {
            "value": "#CBD5E1"
          },
          "strokeWidth": {
            "value": 1.75
          },
          "strokeCap": {
            "value": "round"
          },
          "strokeJoin": {
            "value": "round"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "cardShadow",
      "from": {
        "data": "tree_nodes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "cardX"
          },
          "y": {
            "field": "shadowY"
          },
          "width": {
            "signal": "cardWidth"
          },
          "height": {
            "signal": "cardHeight"
          },
          "cornerRadius": {
            "value": 7
          },
          "fill": {
            "value": "rgba(15, 23, 42, 0.05)"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "cardBody",
      "from": {
        "data": "tree_nodes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "cardX"
          },
          "y": {
            "field": "cardY"
          },
          "width": {
            "signal": "cardWidth"
          },
          "height": {
            "signal": "cardHeight"
          },
          "cornerRadius": {
            "value": 7
          },
          "fill": {
            "value": "#FFFFFF"
          },
          "stroke": [
            {
              "test": "datum.id === hoveredId",
              "value": "#1D4ED8"
            },
            {
              "value": "#E2E8F0"
            }
          ],
          "strokeWidth": [
            {
              "test": "datum.id === hoveredId",
              "value": 2
            },
            {
              "value": 1
            }
          ],
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{'Employee': datum.Name_clean, 'Title': datum.Title_clean, 'ID': datum.id, 'Direct Reports': datum.reportCount, 'Total Headcount': datum.totalDescendants, 'Org Level': datum.depth, 'Status': datum.isCollapsed ? 'Collapsed' : 'Expanded'}"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "cardLeftAccent",
      "from": {
        "data": "tree_nodes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "accentX"
          },
          "y": {
            "field": "accentY"
          },
          "width": {
            "value": 3.5
          },
          "height": {
            "signal": "cardHeight - 14"
          },
          "cornerRadius": {
            "value": 2
          },
          "fill": {
            "scale": "levelColor",
            "field": "depth"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "levelBadgeBg",
      "from": {
        "data": "tree_nodes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "badgeX"
          },
          "y": {
            "field": "badgeY"
          },
          "width": {
            "value": 19
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 5.5
          },
          "fill": {
            "scale": "levelBg",
            "field": "depth"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "levelBadgeText",
      "from": {
        "data": "tree_nodes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "badgeTextX"
          },
          "y": {
            "field": "badgeTextY"
          },
          "text": {
            "signal": "'L' + datum.depth"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 6.5
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "scale": "levelColor",
            "field": "depth"
          },
          "font": {
            "value": "Segoe UI, -apple-system, sans-serif"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "descendantBadgeBg",
      "from": {
        "data": "tree_nodes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "descendantBadgeX"
          },
          "y": {
            "field": "descendantBadgeY"
          },
          "width": {
            "value": 38
          },
          "height": {
            "value": 11
          },
          "cornerRadius": {
            "value": 4
          },
          "fill": {
            "value": "#F8FAFC"
          },
          "stroke": {
            "value": "#E2E8F0"
          },
          "strokeWidth": {
            "value": 0.75
          },
          "opacity": [
            {
              "test": "datum.totalDescendants > 0",
              "value": 1
            },
            {
              "value": 0
            }
          ]
        }
      }
    },
    {
      "type": "text",
      "name": "descendantBadgeText",
      "from": {
        "data": "tree_nodes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "descendantTextX"
          },
          "y": {
            "field": "descendantTextY"
          },
          "text": {
            "signal": "'team ' + datum.totalDescendants"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 6.5
          },
          "fontWeight": {
            "value": "600"
          },
          "fill": {
            "value": "#64748B"
          },
          "opacity": [
            {
              "test": "datum.totalDescendants > 0",
              "value": 1
            },
            {
              "value": 0
            }
          ],
          "font": {
            "value": "Segoe UI, -apple-system, sans-serif"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "employeeName",
      "from": {
        "data": "tree_nodes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "textX"
          },
          "y": {
            "field": "nameY"
          },
          "text": {
            "field": "Name_clean"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": "600"
          },
          "fill": {
            "value": "#0F172A"
          },
          "limit": {
            "signal": "cardWidth - 46"
          },
          "font": {
            "value": "Segoe UI, -apple-system, sans-serif"
          }
        }
      }
    },
    {
      "type": "text",
      "name": "employeeTitle",
      "from": {
        "data": "tree_nodes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "textX"
          },
          "y": {
            "field": "titleY"
          },
          "text": {
            "field": "Title_clean"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 8.5
          },
          "fontWeight": {
            "value": "normal"
          },
          "fill": {
            "value": "#64748B"
          },
          "limit": [
            {
              "test": "datum.totalDescendants > 0",
              "signal": "cardWidth - 58"
            },
            {
              "signal": "cardWidth - 22"
            }
          ],
          "font": {
            "value": "Segoe UI, -apple-system, sans-serif"
          }
        }
      }
    },
    {
      "type": "rect",
      "name": "toggleBtn",
      "from": {
        "data": "tree_nodes"
      },
      "encode": {
        "update": {
          "x": {
            "field": "toggleBtnX"
          },
          "y": {
            "field": "toggleBtnY"
          },
          "width": {
            "value": 28
